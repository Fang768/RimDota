<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!-- Dota2 用的全伤害减免：加算、可为负，接在 IncomingDamageFactor 上。 -->
	<Operation Class="PatchOperationAdd">
		<xpath>/Defs/StatDef[defName="IncomingDamageFactor"]</xpath>
		<value>
			<parts>
				<li Class="RimDota.StatPart_DotaUniversalDamageReduction" />
			</parts>
		</value>
	</Operation>
</Patch>
