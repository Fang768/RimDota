<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!-- 月亮碎片：开局地图上生成的建筑，摧毁后掉落遗迹碎片和翡翠。 -->
	<ThingDef ParentName="BuildingBase">
		<defName>DotaMoonShard</defName>
		<label>月亮碎片</label>
		<description>从天而降的古老月亮碎片。摧毁它可以获得一块遗迹碎片和一些翡翠。</description>
		<graphicData>
			<texPath>Things/Building/DotaMoonShard</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<size>(3,2)</size>
		<statBases>
			<MaxHitPoints>2000</MaxHitPoints>
			<Flammability>0</Flammability>
		</statBases>
		<comps>
			<li Class="RimDota.CompProperties_DestroyedSpawnsItems">
				<spawnOnDestroy>
					<DotaRelicFragment>1</DotaRelicFragment>
					<Jade>50</Jade>
				</spawnOnDestroy>
			</li>
		</comps>
	</ThingDef>

	<!-- 邪月祭坛：可执行英雄觉醒献祭，后续也会作为工作台使用。 -->
	<ThingDef ParentName="BenchBase">
		<defName>DotaCrescentAltar</defName>
		<label>邪月祭坛</label>
		<description>由棕色石台与淡蓝色邪月核心构成的祭坛。可以献祭遗迹碎片，使一名殖民者获得 Dota 英雄身份。祭坛后续也可以作为工作台使用。</description>
		<thingClass>Building_WorkTable</thingClass>
		<graphicData>
			<texPath>Things/Building/DotaCrescentAltar</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<costList>
			<Jade>50</Jade>
			<Steel>250</Steel>
		</costList>
		<stuffCategories>
			<li>Stony</li>
		</stuffCategories>
		<costStuffCount>100</costStuffCount>
		<altitudeLayer>Building</altitudeLayer>
		<fillPercent>0.5</fillPercent>
		<useHitPoints>true</useHitPoints>
		<statBases>
			<WorkToBuild>6000</WorkToBuild>
			<MaxHitPoints>300</MaxHitPoints>
			<Flammability>0</Flammability>
		</statBases>
		<size>(3,2)</size>
		<designationCategory>DotaRelicBuildings</designationCategory>
		<researchPrerequisites>
			<li>DotaTech1</li>
		</researchPrerequisites>
		<passability>PassThroughOnly</passability>
		<pathCost>50</pathCost>
		<hasInteractionCell>true</hasInteractionCell>
		<interactionCellOffset>(0,0,-2)</interactionCellOffset>
		<surfaceType>Item</surfaceType>
		<inspectorTabs>
			<li>ITab_Bills</li>
		</inspectorTabs>
		<placeWorkers>
			<li>PlaceWorker_PreventInteractionSpotOverlap</li>
		</placeWorkers>
	</ThingDef>

	<!-- 邪月观测阵列：由“邪月天体学”解锁的遗迹观测建筑。 -->
	<ThingDef ParentName="BuildingBase">
		<defName>DotaCrescentObservatoryArray</defName>
		<label>邪月观测阵列</label>
		<description>用于观测邪月天体的遗迹阵列。其结构仍有许多部分尚未被理解。</description>
		<graphicData>
			<texPath>Things/Building/DotaCrescentObservatoryArray</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawRotated>false</drawRotated>
		</graphicData>
		<size>(2,2)</size>
		<altitudeLayer>Building</altitudeLayer>
		<fillPercent>0.4</fillPercent>
		<useHitPoints>true</useHitPoints>
		<passability>PassThroughOnly</passability>
		<pathCost>50</pathCost>
		<costList>
			<Steel>200</Steel>
			<ComponentIndustrial>10</ComponentIndustrial>
			<Jade>25</Jade>
		</costList>
		<statBases>
			<WorkToBuild>12000</WorkToBuild>
			<MaxHitPoints>500</MaxHitPoints>
			<Flammability>0</Flammability>
		</statBases>
		<designationCategory>DotaRelicBuildings</designationCategory>
		<researchPrerequisites>
			<li>DotaTech_CrescentAstronomy</li>
		</researchPrerequisites>
	</ThingDef>
</Defs>
