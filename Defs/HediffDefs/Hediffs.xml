<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!-- 示例 HediffDef。可安全删除或替换为你自己的内容。 -->
	<HediffDef>
		<defName>Dota_ExampleBuff</defName>
		<label>示例 buff</label>
		<description>由 RimDota 添加的示例 buff，可安全删除。</description>
		<hediffClass>HediffWithComps</hediffClass>
		<comps>
			<li Class="RimDota.HediffCompProperties_DotaExample" />
		</comps>
	</HediffDef>

	<!-- 框架：隐藏的英雄标记 Hediff。本身无可见效果，用于挂载英雄系统（法力、等级等）。 -->
	<HediffDef>
		<defName>DotaHero</defName>
		<label>Dota hero</label>
		<description>Marks this pawn as a Dota hero and enables hero-only systems such as mana.</description>
		<hediffClass>RimDota.Hediff_DotaHero</hediffClass>
		<comps>
			<li Class="RimDota.HediffCompProperties_DotaHero" />
			<li Class="RimDota.HediffCompProperties_DotaInventory" />
		</comps>
	</HediffDef>

	<HediffDef>
		<defName>DotaMaskOfMadnessBuff</defName>
		<label>狂热</label>
		<description>获得 +100 攻击速度，近战获得 +12% 移动速度、远程获得 +8% 移动速度，但降低 7 点护甲并被沉默。持续 6 秒。</description>
		<hediffClass>HediffWithComps</hediffClass>
		<isBad>false</isBad>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>360</disappearsAfterTicks>
			</li>
		</comps>
		<stages>
			<li>
				<!-- 30% slow resistance is tracked as part of the Dota item design but has no effect yet. -->
				<statOffsets>
					<DotaExternalAttackSpeedBonus>100</DotaExternalAttackSpeedBonus>
					<DotaExternalArmorBonus>-7</DotaExternalArmorBonus>
				</statOffsets>
				<capMods>
					<li>
						<capacity>Talking</capacity>
						<postFactor>0</postFactor>
					</li>
				</capMods>
			</li>
		</stages>
	</HediffDef>
</Defs>
