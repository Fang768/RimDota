<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!-- 示例 HediffDef。可安全删除或替换为你自己的内容。 -->
	<HediffDef>
		<defName>Dota_ExampleBuff</defName>
		<label>示例 buff</label>
		<description>由 RimDota 添加的示例 buff，可安全删除。</description>
		<hediffClass>HediffWithComps</hediffClass>
		<comps>
			<li Class="RimDota.HediffCompProperties_DotaExample" />
		</comps>
	</HediffDef>

	<!-- 框架：隐藏的英雄标记 Hediff。本身无可见效果，用于挂载英雄系统（法力、等级等）。 -->
	<HediffDef>
		<defName>DotaHero</defName>
		<label>Dota hero</label>
		<description>Marks this pawn as a Dota hero and enables hero-only systems such as mana.</description>
		<hediffClass>RimDota.Hediff_DotaHero</hediffClass>
		<comps>
			<li Class="RimDota.HediffCompProperties_DotaHero" />
		</comps>
	</HediffDef>
</Defs>
