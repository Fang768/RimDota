<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- 作者署名 -->
		<Authors>为什么不问问神奇的海螺呢</Authors>

		<!-- 编译产出的 DLL 名称（最终为 RimDota.dll） -->
		<AssemblyName>RimDota</AssemblyName>

		<!-- C# 默认命名空间 -->
		<RootNamespace>RimDota</RootNamespace>

		<!-- RimWorld 1.7 起迁移到 .NET 10（Waylith 引擎），目标框架用 net10.0 -->
		<TargetFramework>net10.0</TargetFramework>

		<!-- preview = 最新 C# 语言特性 -->
		<LangVersion>preview</LangVersion>

		<!-- 输出目录：编译后 DLL 会直接放到 Assemblies/ 下供游戏加载 -->
		<OutDir>..\Assemblies\</OutDir>


		<PlatformTarget>AnyCPU</PlatformTarget>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
		<WarningLevel>4</WarningLevel>

		<!-- 热重载前提：.NET 不会重新加载相同版本号的程序集，所以让版本号每次构建自动递增。
		     必须关闭确定性构建，否则通配符版本号会被编译器拒绝 -->
		<Deterministic>false</Deterministic>
		<AssemblyVersion>1.0.0.*</AssemblyVersion>
		<!-- 通配符版本号会触发 CS7035 提示性警告，这里有意使用通配符，故将其忽略 -->
		<NoWarn>$(NoWarn);7035</NoWarn>
	</PropertyGroup>

	<!-- Debug 配置（默认）：关闭优化，便于调试 -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<Optimize>false</Optimize>
	</PropertyGroup>

	<!-- Release 配置：发布用，开启优化 -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<Optimize>true</Optimize>
	</PropertyGroup>

	<!-- 依赖项 -->
	<ItemGroup>
		<!-- RimWorld 引用程序集（1.7.4979-alpha 对应 1.7 测试版；本机游戏为 1.7.4981 rev136） -->
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4979-alpha" />

		<!-- Harmony：引用 Ref 引用程序集；运行时由 HarmonyRimWorld（brrainz.harmony）统一提供，
		     避免每个 Mod 各带一份 0Harmony.dll 造成版本冲突 -->
		<PackageReference Include="Lib.Harmony.Ref" Version="2.4.3" />
	</ItemGroup>
</Project>
