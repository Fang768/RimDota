<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- 作者署名 -->
		<Authors>为什么不问问神奇的海螺呢</Authors>

		<!-- 编译产出的 DLL 名称（最终为 RimDota.dll） -->
		<AssemblyName>RimDota</AssemblyName>

		<!-- C# 默认命名空间 -->
		<RootNamespace>RimDota</RootNamespace>

		<!-- RimWorld 只支持 .NET Framework 4.7.2 / 4.8 / 4.8.1，这里用 4.7.2 -->
		<TargetFramework>net48</TargetFramework>

		<!-- preview = 最新 C# 语言特性 -->
		<LangVersion>preview</LangVersion>

		<!-- 输出目录：编译后 DLL 会直接放到 Assemblies/ 下供游戏加载 -->
		<OutDir>..\Assemblies\</OutDir>

		<PlatformTarget>AnyCPU</PlatformTarget>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
		<WarningLevel>4</WarningLevel>

		<!-- 热重载前提：.NET 不会重新加载相同版本号的程序集，所以让版本号每次构建自动递增。
		     必须关闭确定性构建，否则通配符版本号会被编译器拒绝 -->
		<Deterministic>false</Deterministic>
		<AssemblyVersion>1.0.0.*</AssemblyVersion>
		<!-- 通配符版本号会触发 CS7035 提示性警告，这里有意使用通配符，故将其忽略 -->
		<NoWarn>$(NoWarn);7035</NoWarn>
	</PropertyGroup>

	<!-- Debug 配置（默认）：热重载调试用。关闭优化，避免方法被内联导致 0Reloader 无法替换 -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<Optimize>false</Optimize>
	</PropertyGroup>

	<!-- Release 配置：发布用，开启优化 -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<Optimize>true</Optimize>
	</PropertyGroup>

	<!-- 依赖项 -->
	<ItemGroup>
		<!-- RimWorld 引用程序集（1.6.4871 与当前游戏版本精确匹配） -->
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" />

		<!-- Harmony 补丁库 -->
		<PackageReference Include="Lib.Harmony" Version="2.*" ExcludeAssets="runtime" />

		<!-- 0Reloader：仅编译期引用，用于 [ReloadMethod] 特性标注要热重载的方法。
		     Private=false 表示不复制到输出目录（Assemblies 里已存在，避免复制到自身）。
		     发布前请删除本引用、Assemblies/0Reloader.dll、代码里的 [ReloadMethod] 与 using Reloader; -->
		<Reference Include="0Reloader">
			<HintPath>..\Assemblies\0Reloader.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>
</Project>
